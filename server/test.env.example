#=====================README-START===============================
# Environment used by integration tests under server/internal/tests/integration.
# The integration test harness hardcodes localhost:15433 and skyvault/skyvault
# credentials (see internal/tests/integration/main_test.go), so POSTGRES_HOST,
# POSTGRES_PORT, POSTGRES_USER, and POSTGRES_PASSWORD MUST match those values.
# The harness creates per-test databases at runtime and overrides DB__NAME /
# DB__DSN / SERVER__DATA_DIR, so those entries below are only used when
# something invokes appconfig.LoadConfig directly against test.env.
#
# To run the test postgres alongside the dev postgres (use a separate compose
# project to avoid colliding with skyvault-db on 15432):
#   just postgres-test-up
# or:
#   docker compose --env-file test.env -p skyvault-test up -d
#
# Required variables:
# - POSTGRES_HOST     (must be localhost)
# - POSTGRES_PORT     (must be 15433)
# - POSTGRES_DB
# - POSTGRES_USER     (must be skyvault)
# - POSTGRES_PASSWORD (must be skyvault)
# - JWT_SECRET_KEY    (min 32 characters)
# - SERVER__PATH      (absolute path to the server directory)
#=====================README-END===============================

POSTGRES_HOST=localhost
POSTGRES_PORT=15433
POSTGRES_DB=skyvault_test
POSTGRES_USER=skyvault
POSTGRES_PASSWORD=skyvault
JWT_SECRET_KEY=test-jwt-secret-key-min-32-chars

# Server Configuration
# Distinct port from dev (8080) so test runs don't collide with a running dev server.
SERVER__PATH=/path/to/skyvault/server
SERVER__DATA_DIR=${SERVER__PATH}/.data-test
SERVER__PORT=8081
SERVER__ADDR=0.0.0.0:${SERVER__PORT}
SERVER__MIGRATIONS_DIR=${SERVER__PATH}/internal/infrastructure/internal/repository/internal/migrations

# Database Configuration
# Distinct container name so it can run alongside the dev DB without conflict.
DB__CONTAINER__IMAGE=postgres:16
DB__CONTAINER__NAME=skyvault-db-test
DB__CONTAINER__PORT=5432

DB__HOST__NAME=${POSTGRES_HOST}
DB__HOST__PORT=${POSTGRES_PORT}
# Only used by compose.yml; the test harness mounts a temp dir per test instead.
DB__HOST__VOLUME=${SERVER__DATA_DIR}/db

DB__NAME=${POSTGRES_DB}
DB__USER=${POSTGRES_USER}
DB__PASS=${POSTGRES_PASSWORD}
DB__CONN_TIMEOUT_SEC=10
# disable sslmode if not using a secure connection(sslmode=disable)
DB__DSN=postgres://${DB__USER}:${DB__PASS}@${DB__HOST__NAME}:${DB__HOST__PORT}/${DB__NAME}?sslmode=disable&connect_timeout=${DB__CONN_TIMEOUT_SEC}

# Auth Configuration
AUTH__JWT__KEY=${JWT_SECRET_KEY}
AUTH__JWT__TOKEN_TIMEOUT_MIN=60

# Storage Configuration
STORAGE__DEFAULT_QUOTA_MB=10

# Logging Configuration
LOG__LEVEL=debug
