{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "types": ["vite/client"],
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "paths": {
      "@sv/components/*": ["src/components/*"],
      "@sv/utils/*": ["src/utils/*"],
      "@sv/pages/*": ["src/pages/*"],
      "@sv/apis/*": ["src/apis/*"],
      "@sv/store/*": ["src/store/*"]
    }
  }
}
